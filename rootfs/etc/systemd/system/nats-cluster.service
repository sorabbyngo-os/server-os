[Unit]
Description=NATS JetStream Cluster — Sorabbyngo message bus
After=network.target sorabbyngo-identity.service
Before=byngox-prime.service novela-backend.service

[Service]
Type=simple
ExecStart=/usr/sbin/nats-server -c /etc/sorabbyngo/nats-cluster.conf
Restart=always
RestartSec=3
User=nats
LimitNOFILE=1000000
OOMScoreAdjust=-800

[Install]
WantedBy=server.target
