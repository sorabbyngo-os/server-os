[Unit]
Description=Byngox Prime — vLLM inference cluster (DeepSeek-R1 70B)
After=nats-cluster.service
Requires=nats-cluster.service

[Service]
Type=simple
ExecStart=/opt/sorabbyngo/bin/byngox-prime \
    --model=deepseek-r1:70b \
    --tensor-parallel=4 \
    --host=0.0.0.0 \
    --port=8000
Restart=on-failure
RestartSec=10
User=sorabbyngo
Environment=NATS_URL=nats://localhost:4222
Environment=CUDA_VISIBLE_DEVICES=0,1,2,3
# Never OOM kill the inference server
OOMScoreAdjust=-1000
LimitNOFILE=65536

[Install]
WantedBy=server.target
